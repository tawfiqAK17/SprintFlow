API documentation:

interfaces:
  Status {
    "TODO" | "IN_PROGRESS" | "TO_BE_TESTED" | "TESTED" | "DONE"
  }

base URL:
  - http://localhost:8080/api

End Points:
  - GET   /
  - POST  /register
    + request:
      - body:
          {
            first_name: string,
            last_name : string,
            email     : string,
            password  : string
          }
    + response:
      - headers:
        . Authorization: Bearer <jwt-token>

  - POST  /login
    + request:
      - body:
          {
            email     : string,
            password  : string
          }
    + response:
      - headers:
        . Authorization: Bearer <jwt-token>


  - POST  /logout
    + request:
      - headers:
        . Authorization: Bearer <jwt-token>

  -<all the following requests should include the <Authorization: Bearer <jwt-token> header>-

  - POST  /projects
    + request:
      - body:
        {
          name              : string,
          description       : string,
          scrum_master_id?  : number,
        }
    + response:
        
  - GET   /projects
    + request:
    + response:
      - body:
        [
          {
            name              : string,
            description       : string,
            scrum_master      : {first_name: string, last_name: string, id: number},
          }
        ]
  - GET   /users
    + request:
      - query parameters:
        . name: string
    + response:
      - body:
        [
          {
            first_name  : string,
            last_name   : string,
            id          : number,
          }
        ]
  - GET   /users/{user_id}
    + request:
    + response:
      - body:
          {
            first_name  : string,
            last_name   : string,
            email       : string,
            id          : number,
            projects    : [{name: string, description: string, id: number}]
          }
  - GET   /profile
    + request:
    + response:
      - body:
          {
            first_name  : string,
            last_name   : string,
            email       : string,
            id          : number,
            projects    : [{name: string, description: string, id: number}]
            tasks       : [{title: string, description: string, status: Status, id: number}]
          }

